# Port for Go HTTP API service
PORT=8550

# Hyperledger Besu JSON-RPC endpoint
BESU_RPC_URL=http://127.0.0.1:8545

# Chain ID for private permissioned QBFT network
BESU_CHAIN_ID=1337

# Deployed address of GovernanceAuditRegistry.sol
REGISTRY_CONTRACT_ADDRESS=0x5FbDB2315678afecb367f032d93F642f64180aa3

# Development-only deployer/submitter private key (Do NOT use in production)
BESU_PRIVATE_KEY=8f2a55949038a9610f50fb23b5883af3b4ecb3c3bb792cbcefbd1542c692be63

# Set to true to use in-memory contract-identical ledger without running Besu node
ENABLE_MOCK_LEDGER=true

# Set to true to simulate offline ledger condition during integration testing
SIMULATE_LEDGER_OFFLINE=false
