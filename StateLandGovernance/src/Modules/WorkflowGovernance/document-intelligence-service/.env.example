# Tesseract OCR executable path (leave empty for PATH discovery)
# Example Windows: TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
# Example Linux: TESSERACT_CMD=/usr/bin/tesseract
TESSERACT_CMD=

# Default OCR language mode (eng, sin, sin+eng)
OCR_DEFAULT_LANGUAGE=sin+eng

# Maximum allowed upload size in megabytes
OCR_MAX_UPLOAD_MB=25

# Rendering resolution (DPI) for PDF to image rasterization
OCR_PDF_DPI=300

# Application log level (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO

# Runtime environment (development, production)
ENVIRONMENT=development

# Semantic Extraction Provider (qwen or gemini, default: qwen)
SEMANTIC_PROVIDER=qwen

# Ollama / Qwen Settings (used when SEMANTIC_PROVIDER=qwen)
# In development, default per-chat timeout is 240.0s to allow complex multi-page extraction.
# In production, default per-chat timeout is 60.0s.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:1.7b
OLLAMA_TIMEOUT_SECONDS=240.0

# Gemini Settings (used when SEMANTIC_PROVIDER=gemini)
# Never commit actual API keys to git.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_TIMEOUT_SECONDS=60.0
