+"use client";
+import Link from "next/link";
+import {usePathname} from "next/navigation";
+import {applicantComplaintSignIn} from "@/modules/component-04/services/applicantComplaintReturn";
+
+export function SignInDestinationLink({pathname,className}:{pathname:string|null;className?:string}){
+ return <Link className={className} href={applicantComplaintSignIn(pathname)}>Sign in</Link>;
+}
+export function SignInLink({className}:{className?:string}){
+ return <SignInDestinationLink pathname={usePathname()} className={className}/>;
+}
