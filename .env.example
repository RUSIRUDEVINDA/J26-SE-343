# Copy to .env and set your local PostgreSQL credentials.
#
# J26-SE-343 research demo (300-parcel Colombo import — recommended for submission demo):
# LAND_INTELLIGENCE_CONNECTION=Host=localhost;Port=5432;Database=land_intel_colombo_state_research;Username=postgres;Password=your_password_here
#
# Full cadastre pilots (real_demo / real_pilot). Do not use land_intel_colombo_demo (DEMO-* fixtures only).
LAND_INTELLIGENCE_CONNECTION=Host=localhost;Port=5432;Database=land_intel_colombo_real_demo;Username=postgres;Password=your_password_here

# Workflow governance PostgreSQL persistence (Component 3)
# WORKFLOW_GOVERNANCE_CONNECTION=Host=localhost;Port=5432;Database=state_land_governance;Username=postgres;Password=your_password_here

# Governance intelligence PostgreSQL persistence (Component 4)
# GOVERNANCE_INTELLIGENCE_CONNECTION=Host=localhost;Port=5432;Database=state_land_governance;Username=postgres;Password=your_password_here

# Lease interest applicant NIC — base64-encoded 32-byte keys (generate locally; do not commit real values)
# LEASE_INTEREST_NIC_ENCRYPTION_KEY=
# LEASE_INTEREST_NIC_LOOKUP_KEY=

# JWT signing key for Component 1 applicant/officer tokens (base64, at least 32 bytes). Required in Production.
# LAND_INTELLIGENCE_JWT_SIGNING_KEY=

# Colombo state research 300-parcel dataset (isolated DB — use only with the research import tool)
# LAND_INTELLIGENCE_STATE_RESEARCH_CONNECTION=Host=localhost;Port=5432;Database=land_intel_colombo_state_research;Username=postgres;Password=your_password_here

# Neo4j knowledge graph (Component 1 — relationship layer only)
NEO4J_CONNECTION=bolt://localhost:7687
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here

# ML suitability service (Component 1 — supplementary evidence only)
ML_SUITABILITY_SERVICE_URL=http://localhost:8500
